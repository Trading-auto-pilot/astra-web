#
# Copy to one of:
# - .env.local (all modes)
# - .env.development.local
# - .env.staging.local
# - .env.production.local
#
# Files ending with *.local are ignored by git (see .gitignore).
#

# Environment prefix for Redis channels (DEV, PAPER, LIVE)
VITE_ENV=DEV

# Backend base URL (override src/config/env.ts DEFAULT_API_BASE)
VITE_API_BASE_URL=http://localhost:8080

# Help / Documentation base URL
VITE_HELP_BASE=http://localhost:3002

# External API key (example)
VITE_FMP_API_KEY=your_key_here
